# Shared secret. Shaadi OS must send the same value (RIDE_BRIDGE_TOKEN in shaadi-os/.env.local).
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Safety switch. 0 = dry run: the phone goes up to the confirm screen and STOPS.
# 1 = really tap "Book" / "Confirm" (real ride, real money). Leave 0 until you have tested.
BRIDGE_ALLOW_BOOKING=0

# 1 = no phone needed; returns sample quotes/bookings (for wiring up and demos).
BRIDGE_MOCK=0

# Optional: specific adb device serial (adb devices). Empty = first device.
ANDROID_SERIAL=

# DroidRun's default LLM profiles use Gemini:
GOOGLE_API_KEY=
