# Shaadi OS: AI invite builder
# Pick one provider: gemini | openai | anthropic
# If nothing is set, the app uses the offline rule-based parser (the demo still works).
LLM_PROVIDER=gemini

# Set the key for the provider you chose (or use LLM_API_KEY for any provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Optional model override (defaults: gemini-2.5-flash, gpt-4o-mini, claude-sonnet-5-5)
# LLM_MODEL=

# Real Uber / Rapido via the phone ride bridge (see ride-bridge/README.md).
# Leave empty to use the built-in demo rates.
RIDE_BRIDGE_URL=
RIDE_BRIDGE_TOKEN=

# WhatsApp: send kaam from your own "Message yourself" chat (see wa-bridge/README.md).
# Leave empty to keep WhatsApp off.
WA_BRIDGE_URL=
WA_BRIDGE_TOKEN=

# Login sessions: required in production (32+ random chars). Generate: openssl rand -hex 32
SESSION_SECRET=

# Sarvam AI (https://dashboard.sarvam.ai): WhatsApp voice notes, replies in the sender's language,
# AI understanding of free-form messages, and the invite in 22 Indian languages. Empty = those stay off.
SARVAM_API_KEY=

# Flagsmith (https://app.flagsmith.com): client-side Environment Key. Flags (create them as booleans, all default on):
# whatsapp_group_mode, whatsapp_voice_notes, whatsapp_native_replies, ai_understanding, invite_translation, real_rides.
# A/B test: multivariate flag "landing_headline" with headline text variants. Empty = all features on.
FLAGSMITH_ENVIRONMENT_KEY=

# The dev server starts wa-bridge on its own. Set to 0 to run it yourself (then set WA_BRIDGE_URL/TOKEN above).
# WA_BRIDGE_AUTOSTART=0

# NudgeBee (https://app.nudgebee.com): Admin -> Integrations -> Webhooks -> Event Webhook -> copy the URL.
# Wedding-day incidents (WhatsApp down, Sarvam failing, unclaimed pickup) are reported there. Empty = off.
NUDGEBEE_EVENT_WEBHOOK_URL=
# Bearer token NudgeBee runbooks send to /api/ops/remediate. Generate: openssl rand -hex 24
NUDGEBEE_ACTION_TOKEN=
