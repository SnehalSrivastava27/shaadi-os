# Shaadi OS: AI invite builder
# Pick one provider: gemini | openai | anthropic
# If nothing is set, the app uses the offline rule-based parser (the demo still works).
LLM_PROVIDER=gemini

# Set the key for the provider you chose (or use LLM_API_KEY for any provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Optional model override (defaults: gemini-2.5-flash, gpt-4o-mini, claude-sonnet-5-5)
# LLM_MODEL=

# Real Uber / Rapido via the phone ride bridge (see ride-bridge/README.md).
# Leave empty to use the built-in demo rates.
RIDE_BRIDGE_URL=
RIDE_BRIDGE_TOKEN=

# WhatsApp: send kaam from your own "Message yourself" chat (see wa-bridge/README.md).
# Leave empty to keep WhatsApp off.
WA_BRIDGE_URL=
WA_BRIDGE_TOKEN=

# Login sessions: required in production (32+ random chars). Generate: openssl rand -hex 32
SESSION_SECRET=
